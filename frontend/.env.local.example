# Server-side URL for the existing FastAPI backend.
BACKEND_API_URL=http://localhost:8000

# Use live API data only after the backend is configured.
NEXT_PUBLIC_API_BASE_URL=/backend-api
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Kolkata
\n# Backend bearer token is entered in Settings & access and held in browser session storage; do not expose it as NEXT_PUBLIC_* or commit it.\n