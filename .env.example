WHATSAPP_ACCESS_TOKEN=
INSTAGRAM_APP_SECRET=
TELEPHONY_WEBHOOK_SECRET=
CALENDAR_PROVIDER=mock
GOOGLE_CALENDAR_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
REDIS_URL=redis://localhost:6379/0
FOLLOWUP_QUIET_START=21:00
FOLLOWUP_QUIET_END=09:00
