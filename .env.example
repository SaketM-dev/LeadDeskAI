# Copy to .env locally. Never commit real credentials.
APP_ENV=development
APP_TIMEZONE=Asia/Kolkata
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leaddesk
AUTH_SECRET=replace-with-local-random-secret
# Temporary shared bearer token for the read-only /api/v1/leads endpoint.
# Generate a long random value locally; do not use this shared token as production user authentication.
LEAD_DESK_API_TOKEN=
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
STT_PROVIDER=mock
STT_API_KEY=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
INSTAGRAM_APP_SECRET=
TELEPHONY_WEBHOOK_SECRET=
CALENDAR_PROVIDER=mock
GOOGLE_CALENDAR_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
REDIS_URL=redis://localhost:6379/0
FOLLOWUP_QUIET_START=21:00
FOLLOWUP_QUIET_END=09:00

# Optional hosted multilingual chatbot (keep the real key only in local .env / deployment secrets).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
